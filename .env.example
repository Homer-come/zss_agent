SERVER_PORT=8080

# Do not commit real keys. Put your DeepSeek key in a local .env or shell export.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_ENABLED=true

FIRECRAWL_API_KEY=
FIRECRAWL_ENABLED=false

MYSQL_URL=jdbc:mysql://localhost:3306/zss_agent?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
MYSQL_USERNAME=zss_agent
MYSQL_PASSWORD=zss_agent
MYSQL_DRIVER=com.mysql.cj.jdbc.Driver

MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USERNAME=root
MILVUS_PASSWORD=milvus
MILVUS_DATABASE=default
MILVUS_COLLECTION=zss_memory
EMBEDDING_DIMENSION=1536
